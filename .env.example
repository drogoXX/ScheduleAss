# Copy to .env and adjust for your deployment. Never commit the real .env.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# "production" hides stack traces and debug affordances in the UI.
APP_ENV=production

# Render full tracebacks in the browser. Leave false in production.
APP_DEBUG=false

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Directory for the SQLite database and log files. Must be writable and, for a
# real deployment, on persistent storage that survives container restarts.
APP_DATA_DIR=instance

# Optional explicit database path (defaults to <APP_DATA_DIR>/schedule_analyzer.db)
# APP_DB_PATH=/var/lib/schedule-analyzer/schedule_analyzer.db

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
APP_LOG_LEVEL=INFO
# APP_LOG_DIR=/var/log/schedule-analyzer

# ---------------------------------------------------------------------------
# Bootstrap administrator
# ---------------------------------------------------------------------------
# Applied ONLY when the user table is empty (first start). If the password is
# left unset, a random one is generated and written to the application log.
APP_ADMIN_USERNAME=admin
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Upload limits
# ---------------------------------------------------------------------------
# Keep APP_MAX_UPLOAD_MB in step with server.maxUploadSize in
# .streamlit/config.toml - that setting guards the transport layer, this one is
# enforced in application code.
APP_MAX_UPLOAD_MB=50
APP_MAX_ACTIVITIES=100000

# ---------------------------------------------------------------------------
# Date parsing
# ---------------------------------------------------------------------------
# P6 exports dates in the exporting machine's locale with no format marker.
#   auto  - infer day-first vs month-first from the file (default)
#   day   - force dd/mm/yyyy
#   month - force mm/dd/yyyy
# ISO (yyyy-mm-dd) dates are always detected automatically and ignore this.
APP_DATE_ORDER=auto

# ---------------------------------------------------------------------------
# Password policy and login throttling
# ---------------------------------------------------------------------------
APP_MIN_PASSWORD_LENGTH=12
APP_MAX_LOGIN_ATTEMPTS=5
APP_LOCKOUT_SECONDS=300
